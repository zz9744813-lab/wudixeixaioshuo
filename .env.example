# Novel Genome — environment configuration
# Copy to `.env` and adjust.

# Local dev uses SQLite (no server needed). For production use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/novel_genome
DATABASE_URL=sqlite:///./novel_genome.db

APP_NAME=Novel Genome
SCHEMA_VERSION=1.0
ENVIRONMENT=local
LOG_LEVEL=INFO

# Reserved for future Redis-backed run registry / queue (EPIC-A)
REDIS_URL=
BROKER_DSN=

# Default source_class for ingested corpora (spec §9, P-09)
DEFAULT_SOURCE_CLASS=human_original
