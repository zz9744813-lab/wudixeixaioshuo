# 小说 Agent 工作台 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 注意: .env 文件不要提交到 git（已在 .gitignore 中排除）

# ============================================
# 安全密钥配置（生产环境必填）
# ============================================

# APP_API_KEY 用于前端访问后端的鉴权
# - 任意高强度随机串即可
# - 前端需要在 localStorage 中设置相同的 Key
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=your-api-key-here-change-in-production

# APP_SECRET_KEY 用于加密存储用户的 LLM API Key
# - 必须是 Fernet.generate_key() 生成的 urlsafe base64 key，不能使用普通 hex 随机串
# - 密钥泄露会导致用户 API Key 被解密，务必保管好
# - 密钥变更后，已加密的 API Key 将无法解密，需要重新配置
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=your-secret-key-here-change-in-production

# ============================================
# 环境配置
# ============================================
# 可选: development, staging, production
# - development: 自动建表、详细日志、不强制要求 API Key
# - production:   强制要求 APP_API_KEY / APP_SECRET_KEY（启动即校验）
# - staging:      同 production，但允许 CORS 测试更宽松
APP_ENV=development

# ============================================
# 数据库配置
# ============================================
# 默认留空即可，程序会自动在 backend/data/ 下创建 SQLite 文件
# 生产推荐 PostgreSQL:
#   DATABASE_URL=postgresql://user:password@postgres:5432/novel_agent
DATABASE_URL=

# ============================================
# 文件存储路径
# ============================================
# 默认留空，程序会在 backend/data/{uploads,artifacts} 下创建
# 部署到 Linux 时建议使用绝对路径，例如 /var/lib/novel-agent/uploads
UPLOAD_DIR=
ARTIFACTS_DIR=

# ============================================
# 日志配置
# ============================================
# 可选: debug, info, warning, error, critical
LOG_LEVEL=info

# ============================================
# CORS 配置
# ============================================
# 多个 origin 用英文逗号分隔，必须填写浏览器实际访问前端所用的完整 URL
# - 本机开发（同机访问）:  http://localhost:3000,http://127.0.0.1:3000
# - Docker Compose 默认:   http://localhost:3005
# - VPS 远程访问:           http://YOUR_SERVER_IP:3005 或 https://your-domain.com
# 注意: 填错或漏填会导致前端请求被浏览器 CORS 拦截
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005

# ============================================
# 前端配置（构建期注入）
# ============================================
# REACT_APP_API_URL: 浏览器请求后端 API 的完整 URL
# - 本机开发（同机访问）:  http://localhost:8000/api
# - Docker Compose 部署:   http://localhost:8000/api
# - VPS 部署（远程浏览器）: http://YOUR_SERVER_IP:8000/api
# - 反向代理（Nginx 等）:  可以留空，前端会使用相对路径 /api
# 注意: 浏览器看到的地址就是这里配置的地址，不能填容器内网地址
REACT_APP_API_URL=http://localhost:8000/api

# ============================================================
# Novel Genome（小说基因组计划）backend —— 仓库根目录 app/
# 与上面的 NovelForge 工作台是同一个仓库里的两个独立后端。
# Novel Genome 使用自己的 SQLAlchemy/SQLite 实例，以下为其专用变量。
# ============================================================
# Novel Genome 服务端口（默认 8123），与 NovelForge 后端(8000)区分开
NOVEL_GENOME_PORT=8123
# Novel Genome 数据库（留空则默认 sqlite:///./novel_genome.db）
NOVEL_GENOME_DATABASE_URL=sqlite:///./novel_genome.db
NOVEL_GENOME_ENVIRONMENT=local
NOVEL_GENOME_LOG_LEVEL=INFO
# 未来 Redis-backed run registry / queue（EPIC-A/§40）。WSL 示例：redis://127.0.0.1:6379/0
REDIS_URL=
BROKER_DSN=

# CORS 允许清单（逗号分隔）。不再默认 "*"——生产必须显式列出前端 origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 摄入语料的默认来源类别（spec §9, P-09）
NOVEL_GENOME_DEFAULT_SOURCE_CLASS=human_original
# LLM 配置（EPIC-C 起使用）：OpenAI 兼容的 base url / key / 默认模型
# 留空时 Novel Genome 使用确定性 Fake Provider，便于无 Key 跑通管线与测试
# 注意：实际生效的变量名是 LLM_BASE_URL / LLM_API_KEY / LLM_MODEL（pydantic 字段名直配）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
